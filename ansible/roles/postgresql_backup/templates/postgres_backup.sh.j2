#!/usr/bin/env bash
set -euo pipefail

BACKUP_DIR="{{ postgres_backup_dir }}"
DB_NAME="{{ postgres_backup_database }}"
RETENTION_DAYS="{{ postgres_backup_retention_days }}"

TIMESTAMP="$(date +%F-%H%M%S)"
BACKUP_FILE="${BACKUP_DIR}/${DB_NAME}-${TIMESTAMP}.dump"

mkdir -p "${BACKUP_DIR}"

pg_dump \
  --format=custom \
  --dbname="${DB_NAME}" \
  --file="${BACKUP_FILE}"

chmod 600 "${BACKUP_FILE}"

find "${BACKUP_DIR}" \
  -type f \
  -name "${DB_NAME}-*.dump" \
  -mtime +"${RETENTION_DAYS}" \
  -delete

echo "Backup created: ${BACKUP_FILE}"

