groups:
  - name: infrastructure-alerts

    rules:
      - alert: NodeDown
        expr: up == 0
        for: 1m

        labels:
          severity: critical

        annotations:
          summary: "Node is unavailable"
          description: "{% raw %}{{ $labels.instance }}{%endraw %} has been unreachable for more than 1 minute."
      - alert: HighCPUUsage
        expr: |
          100 - (
            avg by (instance) (
              rate(node_cpu_seconds_total{mode="idle"}[5m])
            ) * 100
          ) > 80
        for: 5m

        labels:
          serverity: warning
        annotations:
          summary: "High CPU usage"
          description: "CPU usage on {% raw %}{{ $labels.instance }}{% endraw %} is above 80%."
      - alert: HighMemoryUsage
        expr: |
          (
            1 -
            (
              node_memory_MemAvailable_bytes
              /
              node_memory_MemTotal_bytes
            )
          ) * 100 > 90
        for: 5m

        labels:
          severity: warning

        annotations:
          summary: "High memory usage"
          description: "Memory usage on {% raw %} {{ $labels.instance }}{% endraw %} is above 90%."
 
      - alert: HighDiskUsage
        expr: |
          100 * (
            1 -
            (
              node_filesystem_avail_bytes{
                fstype!~"tmpfs|overlay|squashfs"
              }
              /
              node_filesystem_size_bytes{
                fstype!~"tmpfs|overlay|squashfs"
              }
            )
          ) > 90
        for: 5m

        labels:
          severiry: warning
        annotations:
          summary: "High disk usage"
          description: "Disk usage on {% raw %}{{ $labels.instance }}{% endraw %} mount {% raw %}{{ $labels.mountpoint }}{% endraw %} is above 90%."

